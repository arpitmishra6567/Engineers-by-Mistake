# RepairForge AI / Forge Command Configuration
# Copy this file to .env to configure local settings

# Server & Network Settings (for Railway or local runs)
PORT=8000
HOST=0.0.0.0

# CORS Origins (comma-separated URLs, e.g. your Vercel deployment URL)
# Note: https://*.vercel.app is automatically allowed by default
# CORS_ORIGINS=https://forge-command.vercel.app,https://your-custom-domain.com
# CORS_ALLOW_ALL=false

# Model Provider ('mock' or 'openai_compatible')
REPAIRFORGE_PROVIDER=mock

# Model Identifier
REPAIRFORGE_MODEL=mock-repair-model

# Optional OpenAI-Compatible API Credentials & Endpoint
# REPAIRFORGE_API_KEY=your_api_key_here
# REPAIRFORGE_BASE_URL=https://api.openai.com/v1
# REPAIRFORGE_TIMEOUT=30.0
# REPAIRFORGE_TEMPERATURE=0.0

# Execution Policy Settings
# REPAIRFORGE_TIMEOUT_SECONDS=60.0
# REPAIRFORGE_USE_DOCKER=false

